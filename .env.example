# Copy this file to `.env` and fill in your Supabase project values.
# Both vars are read at build time by Vite — restart `npm run dev` after editing.

VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-anon-key

# ---------------------------------------------------------------------------
# Microsoft / Entra ID SSO (5.1) — no client-side env vars needed.
# Configure Supabase Dashboard → Authentication → Providers → Azure:
#   • Enable provider
#   • Azure Tenant: leave blank for multi-tenant (recommended for demo)
#     or paste your tenant id for single-tenant
#   • Client ID / Secret: from your Azure App Registration
#   • Redirect URL (shown by Supabase): paste into Azure App Registration's
#     "Web" redirect URIs alongside `http://localhost:5174/auth/callback`
#     and your Vercel `https://atomalign.vercel.app/auth/callback`
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Notifications (5.2) — secrets live on the Supabase Edge Function, NOT here.
# After deploying the function (`supabase functions deploy notify`), set:
#   supabase secrets set GMAIL_USER=you@gmail.com
#   supabase secrets set GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
#   supabase secrets set GMAIL_FROM_NAME="AtomAlign Notifications"    # optional
#   supabase secrets set TEAMS_WEBHOOK_URL=https://your-tenant.webhook.office.com/...  # optional
#   supabase secrets set APP_BASE_URL=https://atomalign.vercel.app
#
# Generate an App Password at https://myaccount.google.com/apppasswords
# (requires 2-Step Verification to be enabled on the Google account).
# ---------------------------------------------------------------------------
